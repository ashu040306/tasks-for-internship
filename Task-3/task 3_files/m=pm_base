a.put("activities/common/components/filter/filtereditor/filter_editor.ng",'<div class="filter-editor">\n\n  \x3c!-- The contents of a filter --\x3e\n  <div class="contents">\n    <filter-callout ng-if="$ctrl.showFilterCallout()"\n        [filter-type]="$ctrl.getFilterType()"\n        [is-filter-only-field]="$ctrl.showFilterOnlyFieldWarning">\n    </filter-callout>\n    <div class="filter-name-datasource" layout\n         ng-class="$ctrl.shouldShowLegacyDatasourcePicker() ? \'use-legacy-datasource-selector\' : \'\'">\n      \x3c!-- Filter name --\x3e\n      <md-input-container class="filter-name">\n        <label flex>Name</label>\n        <input type="text"\n               ng-model="$ctrl.nameGetterSetter"\n               ng-model-options="{getterSetter: true}"\n               ng-disabled="!$ctrl.isEnabled"\n               autocomplete="off"\n               flex>\n      </md-input-container>\n\n      <datasource-selector-button ng-if="::$ctrl.shouldShowDatasourcePicker()"\n                                  class="filter-datasource-button"\n                                  current-id="{{$ctrl.datasourceId}}"\n                                  [disabled]="!$ctrl.isDatasourcePickerEnabled || !$ctrl.isEnabled"\n                                  [include-blends]=true\n                                  [include-available]=true\n                                  [include-inaccessible]=true\n                                  [can-manage]=false\n                                  [show-add-button]=false\n                                  (on-select-datasource)="$ctrl.onSelectDatasource($event)"\n      ></datasource-selector-button>\n\n      <md-switch ng-if="$ctrl.isEnabled"\n                 class="md-primary, suggestions-toggle"\n                 ng-model="$ctrl.showSuggestions"\n                 ng-change="$ctrl.shouldShowSuggestions()">\n                 Show suggested values while typing\n      </md-switch>\n    </div>\n\n    \x3c!-- Progress indicator when loading schema/ saving filter --\x3e\n    <div layout="row" layout-align="center center">\n      <md-progress-circular md-mode="indeterminate"\n                            md-diameter="25"\n                            ng-show="$ctrl.loading"\n                            class="md-accent">\n      </md-progress-circular>\n    </div>\n\n    <div class="clause-count-message" ng-if="$ctrl.isLookerFilterEditor()">\n      <span>This filter has</span>\n      <span class="clause-count">{{$ctrl.getClauseCountMessage()}}</span>\n    </div>\n\n    \x3c!-- Always Filter Editor for Looker --\x3e\n    <always-filter-editor ng-if="$ctrl.isAlwaysFilterEditor()"\n      [current-filter]="$ctrl.currentFilter"\n      [dimensions]="$ctrl.dimensions"\n      [metrics]="$ctrl.metrics"\n      [datasource-or-view-id]="$ctrl.datasourceId"\n      [schema]="$ctrl.schema"\n      [is-enabled]="$ctrl.isEnabled"\n      [in-ds-mode]="$ctrl.inDsMode"\n      [show-suggestions]="$ctrl.showSuggestions"\n      (on-filter-expression-changed)="$ctrl.updateIsFilterSaved($event)">\n    </always-filter-editor>\n\n    \x3c!-- Conditionally Filter Editor for Looker --\x3e\n    <conditionally-filter-editor ng-if="$ctrl.isConditionallyFilterEditor()"\n      [current-filter]="$ctrl.currentFilter"\n      [dimensions]="$ctrl.dimensions"\n      [metrics]="$ctrl.metrics"\n      [datasource-or-view-id]="$ctrl.datasourceId"\n      [schema]="$ctrl.schema"\n      [is-enabled]="$ctrl.isEnabled"\n      [in-ds-mode]="$ctrl.inDsMode"\n      [show-suggestions]="$ctrl.showSuggestions"\n      (on-filter-expression-changed)="$ctrl.updateIsFilterSaved($event)">\n    </conditionally-filter-editor>\n\n    \x3c!-- AND/OR Filter Editor for Looker --\x3e\n    <and-or-filter-editor ng-if="$ctrl.isAndOrFilterEditor()"\n      [current-filter]="$ctrl.currentFilter"\n      [dimensions]="$ctrl.dimensions"\n      [metrics]="$ctrl.metrics"\n      [datasource-or-view-id]="$ctrl.datasourceId"\n      [schema]="$ctrl.schema"\n      [is-enabled]="$ctrl.isEnabled"\n      [in-ds-mode]="$ctrl.inDsMode"\n      [filter-only-fields]="$ctrl.filterOnlyFields"\n      [num-clauses]="$ctrl.numClauses"\n      [field-usage-map]="$ctrl.fieldUsageMap"\n      [show-suggestions]="$ctrl.showSuggestions"\n      (on-num-clauses-changed)="$ctrl.updateNumberOfClauses($event)"\n      (on-filter-expression-changed)="$ctrl.updateIsFilterSaved($event)"\n      (on-concept-changed)="$ctrl.conceptChanged($event)">\n    </and-or-filter-editor>\n\n    \x3c!-- Regular Filter --\x3e\n    \x3c!-- Filter clauses --\x3e\n    \x3c!-- For every OR filter definition in the top level AND filter--\x3e\n    <div class="or-clause" ng-if="!$ctrl.loading && $ctrl.isNormalFilterEditor()"\n         ng-repeat="orClauseDefinition in $ctrl.currentFilter.filterDefinition.and.filterDefinitions track by $index"\n         ng-init="orClauseIndex = $index">\n\n      \x3c!-- For every filter expression in the OR filter definition --\x3e\n      <div ng-repeat="filterExpressionDefinition in orClauseDefinition.or.filterDefinitions track by $index"\n           class="filter-expression-definition"\n           ng-class="{\'first\':$first,\n                      \'last\':$last,\n                      \'invalid\': !$ctrl.orFilterExpressionsAreSameType(orClauseIndex),\n                      \'contains-ng2-filter-expression-editor\': $ctrl.isNg2FilterExpressionEnabled()}"\n           layout>\n\n        \x3c!-- Ng1 Filter expression editor --\x3e\n          <filter-expression-editor\n            ng-if="!$ctrl.isNg2FilterExpressionEnabled()"\n            filter-expression="filterExpressionDefinition.filterExpression"\n            or-clause-index="orClauseIndex"\n            expression-index="$index"\n            get-concept-options="$ctrl.getConceptOptions(orClauseIndex, expressionIndex)"\n            update-is-filter-saved="$ctrl.updateIsFilterSaved()"\n            schema="$ctrl.schema"\n            is-enabled="$ctrl.isEnabled"\n            datasource-or-view-id="$ctrl.datasourceId"\n            blend-id="$ctrl.getDataViewId()"\n            in-ds-mode="$ctrl.inDsMode">\n        </filter-expression-editor>\n\n        \x3c!-- Ng2 Filter expression editor --\x3e\n        <ng2-filter-expression-editor\n            ng-if="$ctrl.isNg2FilterExpressionEnabled()"\n            [is-enabled]="$ctrl.isEnabled"\n            [in-ds-mode]="$ctrl.inDsMode"\n            [filter-expression]="filterExpressionDefinition.filterExpression"\n            [current-filter]="$ctrl.currentFilter"\n            [dimensions]="$ctrl.dimensions"\n            [metrics]="$ctrl.metrics"\n            [filter-only-fields]="$ctrl.filterOnlyFields"\n            [datasource-or-view-id]="$ctrl.datasourceId"\n            [schema]="$ctrl.schema"\n            [or-clause-index]="orClauseIndex"\n            [expression-index]="$index"\n            [field-usage-map]="$ctrl.fieldUsageMap"\n            [show-suggestions]="$ctrl.showSuggestions"\n            (on-filter-expression-changed)="$ctrl.updateIsFilterSaved($event)"\n            (on-concept-changed)="$ctrl.conceptChanged($event)">\n        </ng2-filter-expression-editor>\n\n        <div flex></div>\n\n        \x3c!-- OR between filter expressions --\x3e\n        <span ng-if="!$last" class="or-between-exp">\n          OR\n        </span>\n        \x3c!-- Show OR link if it is the last existing filter expression and one\n        more expression can be added --\x3e\n        <a ng-if="$ctrl.canAddFilterExpression(orClauseIndex, $index)" href=""\n           ng-click="$ctrl.addFilterExpression(orClauseIndex)"\n           ng-class="{disabled: !$ctrl.isEnabled}"\n           class="or-between-exp or-link">\n          OR\n        </a>\n\n        \x3c!-- Button to remove filter expression --\x3e\n        <div class="close-btn-container">\n          <span class="close-btn"\n                ng-class="{disabled: !$ctrl.isEnabled}"\n                ng-show="$ctrl.numClauses > 1"\n                ng-click="$ctrl.removeFilterExpression(orClauseIndex, $index)"\n                role="button"></span>\n        </div>\n      </div>\n      <div class="invalid"\n           ng-if="!$ctrl.orFilterExpressionsAreSameType(orClauseIndex)">\n        Cannot OR dimension filter clause with a metric filter clause\n      </div>\n\n      \x3c!-- AND between OR clauses --\x3e\n      <div ng-if="!$last" class="and-between-or">\n        AND\n      </div>\n      \x3c!-- Show AND link if it is the last existing OR clause and one more OR\n      clause can be added --\x3e\n      <a ng-if="$last && ($index < $ctrl.maxNumOrClauses - 1)"\n         class="and-between-or and-link" href=""\n         ng-class="{disabled: !$ctrl.isEnabled}"\n         ng-click="$ctrl.addOrClause()" flex>\n        AND\n      </a>\n    </div>\n  </div>\n\n  <div class="bottom-panel">\n    \x3c!-- The number of clauses in the current filter --\x3e\n    <div class="expression-info" ng-if="$ctrl.isNormalFilterEditor() || $ctrl.isAndOrFilterEditor()">\n      {{$ctrl.getFilterExpressionInfoMessage()}}\n    </div>\n    \x3c!-- The editor save action button --\x3e\n    <div class="actions" layout>\n      <md-button class="save fade-in md-accent md-raised"\n                 ng-if="$ctrl.isEnabled"\n                 ng-click="$ctrl.saveFilter()"\n                 ng-disabled="!$ctrl.isFilterValid() || $ctrl.hasChanges()">\n        Save\n      </md-button>\n    </div>\n  </div>\n</div>\n');
a.put("activities/common/components/filter/filterexpressioneditor/filter_expression_editor.ng",['<div class="filter-expression" layout>\n  \x3c!-- filter expression include/exclude dropdown --\x3e\n  <div>\n    <md-select ng-model="$ctrl.negationOptionGetterSetter"\n               ng-model-options="{getterSetter: true}"\n               class="negation-options"\n               ng-disabled="!$ctrl.isEnabled"','               placeholder="'+b("Select a negation option")+'">','      <md-option ng-value="opt.value"\n                 ng-repeat="opt in $ctrl.negationOptions">\n        {{opt.label}}\n      </md-option>\n    </md-select>\n  </div>\n\n  \x3c!-- filter expression concept options dropdown --\x3e\n  <div layout="column" class="select-chip-container">\n    \x3c!-- TODO(jerrychen): adding capability to swtich not using\n         ds-virtual-repeater when # of options is less than N\n    --\x3e\n    \x3c!-- This chip will overlay on the select. This is to be able to click on\n    the chip and edit aggregation options. md-select removes click event\n    listeners on the selected option so this is required here. --\x3e\n    <concept-chip ng-if="$ctrl.isChipOverlayEnabled()"\n                  class="selected-concept-chip"\n                  can-edit="true"\n                  concept-input="$ctrl.concept"\n                  ng-click="$ctrl.openFilterConceptMenu()"\n                  datasource-or-view-id="$ctrl.datasourceOrViewId"\n                  on-save="$ctrl.saveConceptQueryTimeTransformation(conceptData)"\n                  is-any-concept="true"\n                  in-ds-mode="$ctrl.inDsMode">\n    </concept-chip>\n    <div class="concept-options" layout="column"\n         ng-class="{\'invalid\': !$ctrl.isConceptValid()}">\n      <filter-concept-menu ng-if="$ctrl.isEnabled"\n                           get-concept-options="$ctrl.getConceptOptionsForConceptMenu()"\n                           action-with-selected-concept="$ctrl.onConceptSelected(concept)"\n         